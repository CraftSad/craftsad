{
  "name": "@acme/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --env-file=../../.env run next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "bun --env-file=../../.env run next dev --port 3001",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "start": "bun --env-file=../../.env run next start --port 3001",
    "typecheck": "bun --env-file=../../.env run next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@acme/admin-api": "workspace:*",
    "@acme/auth": "workspace:*",
    "@acme/config": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/jobs": "workspace:*",
    "@acme/store": "workspace:*",
    "@acme/ui": "workspace:*",
    "@orpc/client": "2.0.0-beta.53",
    "@orpc/server": "2.0.0-beta.53",
    "@orpc/tanstack-query": "2.0.0-beta.53",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "^5.108.4",
    "better-auth": "1.7.28",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
